# Mool Frontend Environment Variables — Firebase Scaffold
# Fill in real credentials from Firebase Console (Project Settings -> General -> Web App)

VITE_FIREBASE_API_KEY=AIzaSyPlaceholderKeyForMoolPlatform
VITE_FIREBASE_AUTH_DOMAIN=mool-origin-platform.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mool-origin-platform
VITE_FIREBASE_STORAGE_BUCKET=mool-origin-platform.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1

# Optional ML distress prediction service endpoint (for backend integration)
VITE_DISTRESS_PREDICTION_API_URL=https://asia-south1-mool-origin-platform.cloudfunctions.net/predictDistress

# Groq API Key for AI Chat, Sentiment Analysis, and Explainable AI
# Get your free key at https://console.groq.com/
# Models used: llama-3.3-70b-versatile (chat), llama-3.1-8b-instant (sentiment), whisper-large-v3 (voice)
VITE_GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
