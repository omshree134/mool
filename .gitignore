# ==============================================================================
# Mool Platform - Root Git Ignore
# ==============================================================================

# --- Secrets and Environment Files ---
*.env
*.env.*
*.env.local
*.env.*.local
*.local
!*.env.example
!**/*.env.example

# Android & Firebase Credentials
**/google-services.json
!**/google-services.json.example
**/GoogleService-Info.plist
!**/GoogleService-Info.plist.example
**/firebase_sa.json
**/serviceAccountKey*.json
**/local.properties
**/key.properties
**/*.keystore
**/*.jks

# --- Build Artifacts & Binaries ---
*.apk
*.aab
*.dex
*.class
*.exe
cloudflared.exe

# Flutter & Dart Build Outputs
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/doc/api/

# Android Native Build Outputs
**/.gradle/
**/.kotlin/
**/.cxx/
**/captures/
**/GeneratedPluginRegistrant.java
**/buildlog/

# iOS Build Outputs
**/ios/Flutter/.last_build_id
**/Runner.xcworkspace/xcuserdata/
**/Runner.xcodeproj/xcuserdata/

# Node.js & Web Build Outputs
**/node_modules/
**/dist/
**/dist-ssr/
**/.wrangler/
**/.firebase/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python Build Outputs
**/__pycache__/
*.py[cod]
*$py.class
*.so
**/.pytest_cache/
**/venv/
**/env/
**/ENV/

# --- IDE & OS Files ---
.idea/
**/.idea/
.vscode/
**/.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
ehthumbs.db
*.swp
*.swo
*~
*.bak
*.backup
.git_backup*/

# --- Logs ---
*.log
**/logs/
